From: Intel NPU Stack maintainers <maintainers@example.invalid>
Subject: [PATCH] Keep production firmware headers when building the driver

The driver supplies fw_vpu_api_headers as a system include directory. Enabling
the ELF tests adds their restored NNRT headers as a normal include directory,
which takes precedence in the production npu_elf target. Keep the standalone
ELF behavior while allowing the driver target to use its firmware API headers.
The test fixtures and all test targets remain enabled.

--- a/third_party/npu_compiler_elf/CMakeLists.txt
+++ b/third_party/npu_compiler_elf/CMakeLists.txt
@@ -116,7 +116,9 @@
             OUTPUT_VARIABLE NNRT_PATCH_OUTPUT
             ERROR_VARIABLE NNRT_PATCH_ERROR)
 
-        target_include_directories(${LIB_NAME} PRIVATE "${PROJECT_SOURCE_DIR}/3rdparty/nnrt_api/")
+        if(NOT TARGET fw_vpu_api_headers)
+            target_include_directories(${LIB_NAME} PRIVATE "${PROJECT_SOURCE_DIR}/3rdparty/nnrt_api/")
+        endif()
 
         # Ensure `make clean` also drops restored test-only headers.
         set_property(DIRECTORY APPEND PROPERTY ADDITIONAL_MAKE_CLEAN_FILES
