From: Intel NPU Stack maintainers <maintainers@example.invalid>
Subject: [PATCH] Keep production firmware headers when building the driver

npu_compiler_elf now ships its own bundled NNRT API headers under
3rdparty/nnrt and adds that directory as a SYSTEM include on the npu_elf
target unconditionally. Inside the driver build the production target
fw_vpu_api_headers already supplies the driver's exact firmware API
headers, so the ELF copy must not compete with them. Skip the bundled
directory whenever the driver's firmware header target exists; the
standalone ELF build keeps its bundled headers and all test targets.

--- a/third_party/npu_compiler_elf/CMakeLists.txt
+++ b/third_party/npu_compiler_elf/CMakeLists.txt
@@ -101,7 +101,9 @@
 
 target_compile_definitions(${LIB_NAME} PRIVATE $<$<NOT:$<CONFIG:Release>>:NRELEASE>)
 
-target_include_directories(${LIB_NAME} SYSTEM PRIVATE "${PROJECT_SOURCE_DIR}/3rdparty/nnrt")
+if(NOT TARGET fw_vpu_api_headers)
+    target_include_directories(${LIB_NAME} SYSTEM PRIVATE "${PROJECT_SOURCE_DIR}/3rdparty/nnrt")
+endif()
 
 if(ENABLE_NPU_LOADER)
     include(./cmake/gflags.cmake)
