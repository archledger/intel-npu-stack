+class LPExecutorConfigTest : public ov::test::TestsCommon {
+protected:
+    using Table = std::vector<std::vector<int>>;
+    using CoreType = ov::hint::SchedulingCoreType;
+    CPU& cpu = cpu_info();
+    const Table saved_proc = cpu._proc_type_table;
+    const Table saved_org_proc = cpu._org_proc_type_table;
+    const Table saved_mapping = cpu._cpu_mapping_table;
+    const int saved_numa_nodes = cpu._numa_nodes;
+    const int saved_sockets = cpu._sockets;
+
+    void TearDown() override {
+        cpu._proc_type_table = saved_proc;
+        cpu._org_proc_type_table = saved_org_proc;
+        cpu._cpu_mapping_table = saved_mapping;
+        cpu._numa_nodes = saved_numa_nodes;
+        cpu._sockets = saved_sockets;
+    }
+
+    void set_topology(int main, int efficient, int lp, int hyper = 0) {
+        cpu._proc_type_table = {{main + efficient + lp + hyper, main, efficient, lp, hyper, 0, 0}};
+        cpu._org_proc_type_table = cpu._proc_type_table;
+        cpu._cpu_mapping_table.clear();
+        cpu._numa_nodes = cpu._sockets = 1;
+        for (int type = MAIN_CORE_PROC; type <= HYPER_THREADING_PROC; ++type) {
+            for (int n = 0; n < cpu._proc_type_table[0][type]; ++n) {
+                const int core = static_cast<int>(cpu._cpu_mapping_table.size());
+                const int physical_core = type == HYPER_THREADING_PROC ? n : core;
+                cpu._cpu_mapping_table.push_back({core + 4, 0, 0, physical_core, type, physical_core, NOT_USED});
+            }
+        }
+    }
+
+    void check_config(const IStreamsExecutor::Config& config,
+                      const Table& expected_ids,
+                      bool reservation = true,
+                      bool pinning = true) {
+        EXPECT_EQ(reservation, config.get_cpu_reservation());
+        EXPECT_EQ(pinning, config.get_cpu_pinning());
+        const auto table = config.get_streams_info_table();
+        ASSERT_FALSE(table.empty());
+        std::vector<int> typed_threads(HYPER_THREADING_PROC + 1, 0);
+        int streams = 0;
+        int threads = 0;
+        bool all_proc = false;
+        for (size_t i = 0; i < table.size(); ++i) {
+            const auto& row = table[i];
+            ASSERT_EQ(CPU_STREAMS_TABLE_SIZE, row.size());
+            ASSERT_GE(row[PROC_TYPE], ALL_PROC);
+            ASSERT_LE(row[PROC_TYPE], HYPER_THREADING_PROC);
+            EXPECT_GT(row[THREADS_PER_STREAM], 0);
+            EXPECT_GE(row[NUMBER_OF_STREAMS], 0);
+            if (row[NUMBER_OF_STREAMS] > 0) {
+                streams += row[NUMBER_OF_STREAMS];
+                threads += row[NUMBER_OF_STREAMS] * row[THREADS_PER_STREAM];
+                all_proc = row[PROC_TYPE] == ALL_PROC;
+            } else {
+                EXPECT_TRUE(all_proc);
+            }
+            if (row[PROC_TYPE] == ALL_PROC) {
+                ASSERT_LT(i + 1, table.size());
+                EXPECT_EQ(0, table[i + 1][NUMBER_OF_STREAMS]);
+            } else {
+                typed_threads[row[PROC_TYPE]] += std::max(1, row[NUMBER_OF_STREAMS]) * row[THREADS_PER_STREAM];
+            }
+        }
+        std::vector<int> expected_typed_threads(HYPER_THREADING_PROC + 1, 0);
+        std::vector<int> selected_ids;
+        for (const auto& ids : expected_ids) {
+            ASSERT_FALSE(ids.empty());
+            for (int id : ids) {
+                ASSERT_GE(id, 4);
+                ASSERT_LT(static_cast<size_t>(id - 4), cpu._cpu_mapping_table.size());
+                ++expected_typed_threads[cpu._cpu_mapping_table[id - 4][CPU_MAP_CORE_TYPE]];
+                selected_ids.push_back(id);
+            }
+        }
+        EXPECT_EQ(expected_ids.size(), static_cast<size_t>(streams));
+        EXPECT_EQ(streams, config.get_streams());
+        EXPECT_EQ(selected_ids.size(), static_cast<size_t>(threads));
+        EXPECT_EQ(threads, config.get_threads());
+        EXPECT_EQ(table[0][THREADS_PER_STREAM], config.get_threads_per_stream());
+        EXPECT_EQ(expected_typed_threads, typed_threads);
+        EXPECT_EQ(pinning || reservation ? expected_ids : Table{}, config.get_stream_processor_ids());
+        auto remaining = cpu._org_proc_type_table;
+        if (reservation) {
+            remaining[0][ALL_PROC] -= static_cast<int>(selected_ids.size());
+            for (int type = MAIN_CORE_PROC; type <= HYPER_THREADING_PROC; ++type)
+                remaining[0][type] -= expected_typed_threads[type];
+            if (remaining[0][ALL_PROC] == 0)
