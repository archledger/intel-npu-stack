+TEST_P(LPDefaultMultiThreadsTest, UsesTwoFeasibleHomogeneousStreams) {
+    const auto& test_data = GetParam();
+    const auto& topology = test_data.topology;
+    cpu._org_proc_type_table = cpu._proc_type_table = {topology};
+    cpu._numa_nodes = cpu._sockets = 1;
+    const auto core_type = topology[EFFICIENT_CORE_PROC] > 0 ? ov::hint::SchedulingCoreType::ECORE_ONLY
+                                                             : ov::hint::SchedulingCoreType::ANY_CORE;
+    IStreamsExecutor::Config initial{"lp default", 2, 0, core_type};
+    const auto config = IStreamsExecutor::Config::make_default_multi_threaded(initial);
+    const auto table = config.get_streams_info_table();
+    ASSERT_FALSE(table.empty());
+    EXPECT_EQ(test_data.streams, table);
+    int streams = 0;
+    int threads = 0;
+    for (const auto& row : table) {
+        ASSERT_EQ(CPU_STREAMS_TABLE_SIZE, row.size());
+        ASSERT_GT(row[PROC_TYPE], ALL_PROC);
+        ASSERT_LE(row[PROC_TYPE], HYPER_THREADING_PROC);
+        ASSERT_GT(row[NUMBER_OF_STREAMS], 0);
+        EXPECT_GT(row[THREADS_PER_STREAM], 0);
+        streams += row[NUMBER_OF_STREAMS];
+        threads += row[NUMBER_OF_STREAMS] * row[THREADS_PER_STREAM];
+    }
+    EXPECT_EQ(2, streams);
+    EXPECT_EQ(2, config.get_streams());
+    EXPECT_EQ(test_data.threads, threads);
+    EXPECT_EQ(test_data.threads, config.get_threads());
+    EXPECT_EQ(test_data.streams[0][THREADS_PER_STREAM], config.get_threads_per_stream());
+    EXPECT_TRUE(config.get_stream_processor_ids().empty());
+    EXPECT_EQ(cpu._org_proc_type_table, cpu._proc_type_table);
+}
