+int get_tbb_core_type(int proc_type,
+                      const std::vector<int>& core_types,
+                      const std::vector<std::vector<int>>& proc_type_table) {
+    auto real_core_type =
+        (proc_type == MAIN_CORE_PROC || proc_type == HYPER_THREADING_PROC) ? core_types.back() : core_types.front();
+    if (proc_type == EFFICIENT_CORE_PROC && core_types.size() >= 3) {
+        real_core_type = *(core_types.end() - 2);
+    } else if (proc_type == EFFICIENT_CORE_PROC && core_types.size() == 2 && !proc_type_table.empty() &&
+               proc_type_table[0][EFFICIENT_CORE_PROC] > 0 && proc_type_table[0][LP_EFFICIENT_CORE_PROC] > 0 &&
+               proc_type_table[0][MAIN_CORE_PROC] == 0 && proc_type_table[0][HYPER_THREADING_PROC] == 0) {
+        // Without P cores the ordered pair is [LP, E], not [E, P].
+        real_core_type = core_types.back();
+    }
+    return real_core_type;
+}
