+class LPDefaultMultiThreadsTest : public ov::test::TestsCommon,
+                                  public testing::WithParamInterface<LPDefaultMultiThreadsTestCase> {
+protected:
+    CPU& cpu = cpu_info();
+    const std::vector<std::vector<int>> saved_proc = cpu._proc_type_table;
+    const std::vector<std::vector<int>> saved_org_proc = cpu._org_proc_type_table;
+    const int saved_numa_nodes = cpu._numa_nodes;
+    const int saved_sockets = cpu._sockets;
