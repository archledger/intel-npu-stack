@@ -3,17 +3,11 @@
 # SPDX-License-Identifier: Apache-2.0
 #
 
-execute_process(
-    COMMAND
-        git rev-parse HEAD
-    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
-    OUTPUT_VARIABLE CURRENT_NPU_LOADER_SHA
-    OUTPUT_STRIP_TRAILING_WHITESPACE
-    RESULT_VARIABLE ERROR_CODE
-)
-
-if (NOT ${ERROR_CODE} EQUAL 0)
-    message(FATAL_ERROR "Failed to retrieve version")
+string(LENGTH "${CURRENT_NPU_LOADER_SHA}" CURRENT_NPU_LOADER_SHA_LENGTH)
+if (NOT CURRENT_NPU_LOADER_SHA_LENGTH EQUAL 40 OR
+    NOT CURRENT_NPU_LOADER_SHA MATCHES "^[0-9a-f]+$")
+    message(FATAL_ERROR
+        "CURRENT_NPU_LOADER_SHA must be the locked 40-character loader commit")
 endif()
 
 set(LAST_NPU_LOADER_SHA "")
